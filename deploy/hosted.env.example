# Agent Manager - hosted (second) instance.
# A completely fresh, self-contained deployment: its own empty database,
# its own per-agent workspaces, its own OpenCode runtime port.
#
# No secrets belong in this file:
#   - APP_SECRET:      auto-generated into data-hosted/secret.key on first boot
#   - Admin password:  created in the browser on first visit
#                      (stored as an encrypted scrypt hash, never in a file)
#   - OpenRouter key:  pasted once in the dashboard (Settings -> OpenRouter key),
#                      encrypted at rest in the database
#
PORT=8788
OPENCODE_PORT=4297
DATA_DIR=./data-hosted
HOST=127.0.0.1
HUB_AUTOSTART=1
LOG_LEVEL=info
